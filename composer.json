{
    "name": "fising/laravel-dm8",
    "description": "Dameng DM8 database driver for Laravel",
    "homepage": "https://github.com/fising/laravel-dm8",
    "license": "MIT",
    "authors": [
        {
            "name": "Mick",
            "email": "fising@qq.com"
        },
        {
            "name": "Jack Final",
            "email": "final_m@foxmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-pdo": "*",
        "illuminate/database": "^6.0|^7.0|^8.0|^9.0",
        "illuminate/pagination": "^6.0|^7.0|^8.0|^9.0",
        "illuminate/support": "^6.0|^7.0|^8.0|^9.0",
        "illuminate/validation": "^6.0|^7.0|^8.0|^9.0"
    },
    "require-dev": {
        "doctrine/dbal": "^3.3",
        "mockery/mockery": "^1.4.4",
        "orchestra/testbench": "^4.0|^5.0|^6.0|^7.0",
        "phpunit/phpunit": "^9.5.8"
    },
    "autoload": {
        "files": [
          "src/helper.php"
        ],
        "psr-4": {
            "LaravelDm8\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelDm8\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
          "dev-master": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "LaravelDm8\\Dm8\\Dm8ServiceProvider",
                "LaravelDm8\\Dm8\\Dm8ValidationServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
